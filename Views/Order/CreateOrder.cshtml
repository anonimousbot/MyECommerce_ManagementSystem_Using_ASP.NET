@model EMS.Models.DTOs.Orders.CreateOrderRequestModel

@{
    ViewBag.Title = "Place Order";
}

<div class="page-heading">
    <div>
        <h1 class="page-title">Place order</h1>
        <p class="page-subtitle">Confirm your quantity, review the total, and send the order with a cleaner checkout-ready flow.</p>
    </div>
    <div class="page-action-row">
        <a asp-action="Index" asp-controller="Customer" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to items
        </a>
    </div>
</div>

@if (ViewBag.Failed != null)
{
    <div class="alert alert-danger">@ViewBag.Failed</div>
}

@if (ViewBag.Success != null)
{
    <div class="alert alert-success">@ViewBag.Success</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="section-shell">
            <form asp-action="CreateOrder" method="post" id="orderForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ItemId" />
                <input type="hidden" asp-for="CustomerId" value="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)" />

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" id="Quantity" oninput="calculateTotal()" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" class="form-control" id="Amount" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="TotalAmount" class="form-label"></label>
                    <input asp-for="TotalAmount" class="form-control" id="TotalAmount" readonly />
                    <span asp-validation-for="TotalAmount" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DeliveryAddress" class="form-label"></label>
                    <textarea asp-for="DeliveryAddress" class="form-control" rows="4" placeholder="Enter your delivery address" required></textarea>
                    <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                </div>

                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmOrderModal">
                    <i class="bi bi-bag-check me-2"></i>Review order
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <div class="metric-label"><i class="bi bi-lightning-charge"></i>Quick summary</div>
                <div class="metric-value" style="font-size: 1.35rem;">Ready to confirm</div>
                <p class="page-subtitle mt-2">Your total updates automatically as soon as quantity changes, so the confirmation modal reflects exactly what you are about to submit.</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmOrderModal" tabindex="-1" aria-labelledby="confirmOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmOrderModalLabel">Confirm your order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Please review the order details before you continue.</p>
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Quantity</span>
                            <strong id="confirmQuantity"></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Unit Price</span>
                            <strong id="confirmAmount"></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Total Amount</span>
                            <strong class="text-success" id="confirmTotalAmount"></strong>
                        </div>
                        <div>
                            <strong>Delivery Address</strong>
                            <p class="mb-0 mt-2 text-muted" id="confirmAddress"></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitOrder()">Confirm order</button>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.ShowStockError == true)
{
    <script>
        window.onload = function () {
            var myModal = new bootstrap.Modal(document.getElementById('stockErrorModal'));
            myModal.show();
        }
    </script>

    <div class="modal fade" id="stockErrorModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Stock error</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger mb-0">The quantity you selected is more than what is available in the store.</div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ViewBag.OrderSuccess == true)
{
    <script>
        window.onload = function () {
            var myModal = new bootstrap.Modal(document.getElementById('successModal'));
            myModal.show();
        }
    </script>

    <div class="modal fade" id="successModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Order placed</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-success mb-0">Your order has been placed successfully.</div>
                </div>
                <div class="modal-footer">
                    <a href="@Url.Action("Index", "Customer")" class="btn btn-primary">Back to shop</a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function calculateTotal() {
            var quantity = parseFloat(document.getElementById('Quantity').value) || 0;
            var amount = parseFloat(document.getElementById('Amount').value) || 0;
            var totalAmount = quantity * amount;

            document.getElementById('TotalAmount').value = totalAmount.toFixed(2);
        }

        document.getElementById('confirmOrderModal').addEventListener('show.bs.modal', function () {
            var quantity = document.querySelector('input[name="Quantity"]').value;
            var amount = document.getElementById('Amount').value;
            var totalAmount = document.getElementById('TotalAmount').value;
            var address = document.querySelector('textarea[name="DeliveryAddress"]').value;

            document.getElementById('confirmQuantity').textContent = quantity;
            document.getElementById('confirmAmount').textContent = amount;
            document.getElementById('confirmTotalAmount').textContent = totalAmount;
            document.getElementById('confirmAddress').textContent = address || 'No address provided';
        });

        function submitOrder() {
            var confirmModal = bootstrap.Modal.getInstance(document.getElementById('confirmOrderModal'));
            confirmModal.hide();
            document.getElementById('orderForm').submit();
        }
    </script>
}
