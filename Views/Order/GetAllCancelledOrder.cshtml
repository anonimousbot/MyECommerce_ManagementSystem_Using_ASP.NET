@using EMS.Models.DTOs

@model BaseResponse<IReadOnlyList<EMS.Models.DTOs.Orders.OrderDto>>
@{

    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Orders";
}
<div class="container mt-4">
    <h2 class="mb-4 text-center">All Orders</h2>

    @if (Model?.Data == null || !Model.Data.Any())
    {
        <div class="alert alert-info text-center">No orders found.</div>
    }
    else
    {
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    @* <th>Order ID</th> *@
                    <th>Customer Name</th>
                    <th>Item Name</th>
                    <th>Quantity</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Date Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Data)
                {
                    <tr>
                        @* <td>@order.Id</td> *@
                        <td>
                            @order.Customer?.FullName()
                        </td>
                        <td>
                            @foreach (var itemname in order?.OrderItem)
                            {
                                <p>@itemname.Item.Name</p>
                            }
                        </td>
                        <td>
                            @foreach (var item in order?.OrderItem)
                            {
                                <p>@item.Quantity</p>
                            }
                        </td>
                        <td>@order.Amount.ToString().TrimEnd('0').TrimEnd('.')</td>
                        <td>@order.OrderStatus</td>
                        <td>@order.DateCreated.ToString("dd-MMM-yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary">View</a>
                            <a asp-action="UpdateOrder" asp-route-id="@order.Id" asp-controller="Order" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-controller="Order" asp-route-id="@order.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

