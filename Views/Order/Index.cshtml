@using EMS.Models.DTOs

@model BaseResponse<IEnumerable<EMS.Models.DTOs.Orders.OrderDto>>
@{

    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Orders";
}
<div class="container mt-4">
    <h2 class="mb-4 text-center">All Orders</h2>

    @if (Model?.Data == null || !Model.Data.Any())
    {
        <div class="alert alert-info text-center">No orders found.</div>
    }
    else
    {
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    @* <th>Order ID</th> *@
                    <th>Customer Name</th>
                    <th>Item Name</th>
                    <th>Quantity</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Date Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Data)
                {
                    <tr>
                        @* <td>@order.Id</td> *@
                        <td>
                           @order.Customer?.FullName()
                        </td>
                        <td>@foreach(var itemname in order?.OrderItem)
                            {
                                <p>@itemname.Item.Name</p>
                            }
                        </td>
                        <td>@foreach(var item in order?.OrderItem)
                            {
                                <p>@item.Quantity</p>
                            }
                        </td>
                        <td>@order.Amount.ToString().TrimEnd('0').TrimEnd('.')</td>
                        <td>@order.OrderStatus</td>
                        <td>@order.DateCreated.ToString("dd-MMM-yyyy")</td>
                        <td>
                            <a asp-action="GetOrdersById" asp-route-id="@order.Id" class="btn btn-sm btn-primary">View</a>
                            <a asp-action="UpdateOrder" asp-route-id="@order.Id" asp-controller="Order" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-controller="Order" asp-route-id="@order.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (Model?.Pagination != null && Model.Pagination.TotalPages > 1)
{
    <nav aria-label="Order pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Pagination.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-controller="Order"
                   asp-route-pageNumber="@(Model.Pagination.PageNumber - 1)"
                   asp-route-pageSize="@Model.Pagination.PageSize">Previous</a>
            </li>
            @for (var pageIndex = 1; pageIndex <= Model.Pagination.TotalPages; pageIndex++)
            {
                <li class="page-item @(pageIndex == Model.Pagination.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-controller="Order"
                       asp-route-pageNumber="@pageIndex"
                       asp-route-pageSize="@Model.Pagination.PageSize">@pageIndex</a>
                </li>
            }
            <li class="page-item @(Model.Pagination.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-controller="Order"
                   asp-route-pageNumber="@(Model.Pagination.PageNumber + 1)"
                   asp-route-pageSize="@Model.Pagination.PageSize">Next</a>
            </li>
        </ul>
    </nav>
}
