@using EMS.Models.DTOs

@{
    ViewData["Title"] = "Delete Order";
}

@model BaseResponse<EMS.Models.DTOs.Orders.OrderDto>
<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h3>Delete Order</h3>
        </div>
        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>Warning!</strong> Are you sure you want to delete this order? This action cannot be undone.
            </div>

            <dl class="row">
                @* <dt class="col-sm-3">Order ID:</dt>
                <dd class="col-sm-9">@Model.Data.Id</dd> *@

                <dt class="col-sm-3">Customer:</dt>
                <dd class="col-sm-9">@Model.Data.Customer?.FullName()</dd>

                <dt class="col-sm-3">Order Date:</dt>
                <dd class="col-sm-9">@Model.Data.DateCreated.ToString("MMM dd, yyyy")</dd>

                <dt class="col-sm-3">Total Amount:</dt>
                <dd class="col-sm-9">$@Model.Data.Amount.ToString("N2")</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info">@Model.Data.OrderStatus</span>
                </dd>
            </dl>

            <form asp-action="Delete"  asp-controller = "Order" asp-route-id="@Model.Data.Id" method="post" class="mt-4">
               
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Confirm Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Optional: Add confirmation dialog
        document.querySelector('form').addEventListener('submit', function(e) {
            if (!confirm('Are you absolutely sure you want to delete this order?')) {
                e.preventDefault();
            }
        });
    </script>
}