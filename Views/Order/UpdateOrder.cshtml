@using EMS.Models.Enums
@using EMS.Models.DTOs
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Update Order Status";
}

@model BaseResponse<EMS.Models.DTOs.Orders.OrderDto>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
                    <h4 class="mb-0">Update Order Status</h4>
                </div>

                <div class="card-body p-4">

                    <div class="mb-3">
                        <label class="form-label fw-bold">Current Status</label>
                        <input type="text" class="form-control" value="@ViewBag.OrderStatus" disabled />
                    </div>

                    <form asp-action="UpdateOrder" asp-controller="Order" asp-route-id="@Model.Data.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mt-3 mb-4">
                            <label class="form-label fw-bold">New Status</label>
                            <select name="Status" class="form-select" asp-items="@Html.GetEnumSelectList(typeof(Status))" required></select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-bold">
                            Update Status
                        </button>
                    </form>

                </div>

            </div>

        </div>
    </div>
</div>
