@model EMS.Models.DTOs.Items.CreateItemRequestModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Product";
    ViewData["AdminHeading"] = "Create New Product";
    ViewData["AdminSubtitle"] = "Add a new industrial electrical component to the EMS catalog with clean pricing, stock, and media details.";
}

@section Head {
    <style>
        :root {
            --primary-fixed: #eaddff;
            --inverse-primary: #d2bcff;
            --tertiary-fixed-dim: #bec6e0;
            --on-tertiary-container: #c8cfe9;
            --surface-variant: #e7e0ee;
            --on-tertiary: #ffffff;
            --on-secondary: #ffffff;
            --inverse-surface: #332f39;
            --on-primary-fixed: #25005a;
            --surface-container-lowest: #ffffff;
            --secondary-container: #fd761a;
            --secondary-fixed-dim: #ffb690;
            --background: #fef7ff;
            --surface: #fef7ff;
            --surface-tint: #7233df;
            --error: #ba1a1a;
            --on-background: #1d1a24;
            --tertiary-container: #51586e;
            --surface-container-highest: #e7e0ee;
            --surface-container-low: #f9f1ff;
            --surface-container-high: #ede5f3;
            --outline-variant: #ccc3d7;
            --on-primary-container: #dac7ff;
            --outline: #7b7486;
            --secondary-fixed: #ffdbca;
            --on-secondary-container: #5c2400;
            --on-surface: #1d1a24;
            --surface-dim: #dfd7e5;
            --primary: #5300b9;
            --on-surface-variant: #4a4455;
            --primary-fixed-dim: #d2bcff;
            --error-container: #ffdad6;
            --tertiary: #394156;
            --on-tertiary-fixed-variant: #3f465c;
            --tertiary-fixed: #dae2fd;
            --secondary: #9d4300;
            --primary-container: #6c2bd9;
            --surface-bright: #fef7ff;
            --on-secondary-fixed: #341100;
            --on-error-container: #93000a;
            --on-tertiary-fixed: #131b2e;
            --on-secondary-fixed-variant: #783200;
            --surface-container: #f3ebf9;
            --on-primary-fixed-variant: #5900c7;
            --on-primary: #ffffff;
            --on-error: #ffffff;
            --inverse-on-surface: #f6eefc;
        }

        .create-canvas {
            color: var(--on-background);
        }

        .create-canvas input[type="file"]::file-selector-button {
            margin-right: 1rem;
            border: 0;
            border-radius: 0.75rem;
            background: var(--primary);
            color: var(--on-primary);
            padding: 0.65rem 1rem;
            font-weight: 600;
            cursor: pointer;
        }

        .create-canvas input[type="file"]::file-selector-button:hover {
            opacity: 0.92;
        }
    </style>
}

@section AdminActions {
    <a asp-action="Index" asp-controller="Item" class="inline-flex items-center gap-2 rounded-lg border border-[var(--outline-variant)] bg-[var(--surface)] px-4 py-3 text-sm font-semibold text-[var(--on-surface)] transition hover:bg-[var(--surface-container)]">
        <span class="material-symbols-outlined text-[18px]">close</span>
        Cancel
    </a>
    <button type="submit" form="create-item-form" class="inline-flex items-center gap-2 rounded-lg bg-[var(--primary)] px-4 py-3 text-sm font-semibold text-[var(--on-primary)] transition hover:opacity-90">
        <span class="material-symbols-outlined text-[18px]">save</span>
        Save Product
    </button>
}

<div class="create-canvas">
    <form id="create-item-form" asp-controller="Item" asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">
        @Html.AntiForgeryToken()

        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-3xl font-semibold tracking-tight text-[var(--on-surface)]">Create New Product</h1>
                <p class="mt-2 text-base text-[var(--on-surface-variant)]">Add a new industrial electrical component to the EMS catalog.</p>
            </div>
            <div class="hidden gap-3 md:flex">
                <a asp-action="Index" asp-controller="Item" class="inline-flex items-center justify-center rounded-lg border border-[var(--outline-variant)] px-5 py-3 font-semibold text-[var(--on-surface)] transition hover:bg-[var(--surface-container)]">
                    Cancel
                </a>
                <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-[var(--primary)] px-5 py-3 font-semibold text-[var(--on-primary)] transition hover:opacity-90">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    Save Product
                </button>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="rounded-xl border border-[var(--error-container)] bg-[var(--error-container)]/50 px-4 py-3 text-sm text-[var(--on-error-container)]"></div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
            <section class="md:col-span-8 rounded-xl border border-[var(--outline-variant)] bg-[var(--surface-container-lowest)] p-6 shadow-sm">
                <h2 class="text-xl font-semibold text-[var(--on-surface)]">Basic Information</h2>
                <div class="mt-6 space-y-5">
                    <div class="flex flex-col gap-2">
                        <label asp-for="Name" class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--on-surface-variant)]">Product Name</label>
                        <input asp-for="Name"
                               type="text"
                               placeholder="e.g. 3-Phase Industrial Transformer"
                               class="w-full rounded-lg border-[var(--outline-variant)] bg-[var(--surface)] px-4 py-3 text-base text-[var(--on-surface)] focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary-fixed-dim)]" />
                        <span asp-validation-for="Name" class="text-sm text-[var(--error)]"></span>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label asp-for="Brand" class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--on-surface-variant)]">Brand</label>
                        <input asp-for="Brand"
                               type="text"
                               placeholder="e.g. Siemens, ABB, Schneider Electric"
                               class="w-full rounded-lg border-[var(--outline-variant)] bg-[var(--surface)] px-4 py-3 text-base text-[var(--on-surface)] focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary-fixed-dim)]" />
                        <span asp-validation-for="Brand" class="text-sm text-[var(--error)]"></span>
                    </div>

                    <div class="rounded-xl border border-[var(--outline-variant)] bg-[var(--surface-container-low)] p-4">
                        <p class="text-sm font-semibold text-[var(--on-surface)]">Catalog Guidance</p>
                        <p class="mt-2 text-sm leading-6 text-[var(--on-surface-variant)]">
                            Keep product names specific and technical. Use the brand field for manufacturer identity so inventory and storefront listings stay easy to scan.
                        </p>
                    </div>
                </div>
            </section>

            <aside class="md:col-span-4 space-y-6">
                <section class="rounded-xl border border-[var(--outline-variant)] bg-[var(--surface-container-lowest)] p-6 shadow-sm">
                    <h2 class="text-xl font-semibold text-[var(--on-surface)]">Pricing &amp; Stock</h2>
                    <div class="mt-6 space-y-5">
                        <div class="flex flex-col gap-2">
                            <label asp-for="Price" class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--on-surface-variant)]">Unit Price (NGN)</label>
                            <div class="relative">
                                <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 font-mono text-sm text-[var(--on-surface-variant)]">&#8358;</span>
                                <input asp-for="Price"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="0.00"
                                       class="w-full rounded-lg border-[var(--outline-variant)] bg-[var(--surface)] py-3 pl-10 pr-4 text-base text-[var(--on-surface)] focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary-fixed-dim)]" />
                            </div>
                            <span asp-validation-for="Price" class="text-sm text-[var(--error)]"></span>
                        </div>

                        <div class="flex flex-col gap-2">
                            <label asp-for="QuantityInStock" class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--on-surface-variant)]">Stock Level</label>
                            <input asp-for="QuantityInStock"
                                   type="number"
                                   min="0"
                                   placeholder="0"
                                   class="w-full rounded-lg border-[var(--outline-variant)] bg-[var(--surface)] px-4 py-3 font-mono text-base text-[var(--on-surface)] focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary-fixed-dim)]" />
                            <span asp-validation-for="QuantityInStock" class="text-sm text-[var(--error)]"></span>
                        </div>
                    </div>
                </section>

                <section class="rounded-xl border border-[var(--outline-variant)] bg-[var(--surface-container-lowest)] p-6 shadow-sm">
                    <h2 class="text-xl font-semibold text-[var(--on-surface)]">Classification</h2>
                    <div class="mt-6 space-y-4">
                        <div class="rounded-lg border border-[var(--outline-variant)] bg-[var(--surface)] px-4 py-3">
                            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--on-surface-variant)]">Catalog Status</p>
                            <p class="mt-2 text-sm font-semibold text-[var(--primary)]">Ready for inventory publishing</p>
                        </div>
                        <div class="rounded-lg border border-[var(--outline-variant)] bg-[var(--surface)] px-4 py-3">
                            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--on-surface-variant)]">Backend Support</p>
                            <p class="mt-2 text-sm leading-6 text-[var(--on-surface-variant)]">This form currently stores name, brand, price, stock quantity, and a product image.</p>
                        </div>
                    </div>
                </section>
            </aside>

            <section class="md:col-span-12 rounded-xl border border-[var(--outline-variant)] bg-[var(--surface-container-lowest)] p-6 shadow-sm">
                <h2 class="text-xl font-semibold text-[var(--on-surface)]">Product Media</h2>

                <div class="mt-6 rounded-xl border-2 border-dashed border-[var(--outline-variant)] p-8 text-center transition hover:border-[var(--primary)]">
                    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[var(--surface-container)] text-[var(--on-surface-variant)] transition hover:bg-[var(--primary-container)] hover:text-[var(--on-primary-container)]">
                        <span class="material-symbols-outlined text-[32px]">upload_file</span>
                    </div>
                    <p class="mt-4 text-lg font-semibold text-[var(--on-surface)]">Upload product image</p>
                    <p class="mt-1 text-sm text-[var(--on-surface-variant)]">High-resolution JPEG, PNG, WEBP, or GIF. Max size 5MB.</p>
                    <div class="mx-auto mt-6 max-w-xl">
                        <input asp-for="Image"
                               id="product-image-input"
                               type="file"
                               accept="image/*"
                               class="block w-full rounded-xl border border-[var(--outline-variant)] bg-[var(--surface)] px-4 py-3 text-sm text-[var(--on-surface)] focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary-fixed-dim)]" />
                        <span asp-validation-for="Image" class="mt-2 block text-sm text-[var(--error)]"></span>
                    </div>
                </div>

                <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    <div id="image-preview-card" class="hidden aspect-square overflow-hidden rounded-lg border border-[var(--outline-variant)] bg-[var(--surface-container)]">
                        <img id="image-preview" alt="Selected product preview" class="h-full w-full object-cover" />
                    </div>
                    <div class="flex aspect-square items-center justify-center rounded-lg border-2 border-dashed border-[var(--outline-variant)] bg-[var(--surface-container-low)] text-[var(--on-surface-variant)]">
                        <div class="text-center">
                            <span class="material-symbols-outlined">image</span>
                            <p class="mt-2 text-sm">Preview appears here</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="flex gap-4 md:hidden">
            <a asp-action="Index" asp-controller="Item" class="flex-1 rounded-lg border border-[var(--outline-variant)] px-4 py-3 text-center font-semibold text-[var(--on-surface)]">
                Cancel
            </a>
            <button type="submit" class="flex-1 rounded-lg bg-[var(--primary)] px-4 py-3 font-semibold text-[var(--on-primary)]">
                Save
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const input = document.getElementById("product-image-input");
            const previewCard = document.getElementById("image-preview-card");
            const previewImage = document.getElementById("image-preview");

            if (!input || !previewCard || !previewImage) {
                return;
            }

            input.addEventListener("change", event => {
                const file = event.target.files && event.target.files[0];
                if (!file) {
                    previewCard.classList.add("hidden");
                    previewImage.removeAttribute("src");
                    return;
                }

                const reader = new FileReader();
                reader.onload = loadEvent => {
                    previewImage.src = loadEvent.target?.result;
                    previewCard.classList.remove("hidden");
                };
                reader.readAsDataURL(file);
            });
        })();
    </script>
}
