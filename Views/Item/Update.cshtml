@model EMS.Models.DTOs.Items.UpdateItemViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Update Product";
    ViewData["AdminHeading"] = "Update Product";
    ViewData["AdminSubtitle"] = "Edit pricing, stock, branding, and imagery for this catalog item.";
}

<section class="mx-auto max-w-4xl">
    <div class="rounded-[1.5rem] border border-[var(--outline-variant)] bg-[var(--surface)] shadow-sm">
        <div class="border-b border-[var(--outline-variant)] px-6 py-5">
            <h3 class="text-xl font-bold text-[var(--primary)]">Edit Inventory Item</h3>
            <p class="mt-1 text-sm text-[var(--on-surface-variant)]">Update the product record and save changes back to inventory.</p>
        </div>

        <div class="px-6 py-6">
            <form asp-action="Update" asp-controller="Item" method="post" enctype="multipart/form-data" class="space-y-6">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="CurrentImagePath" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="rounded-xl border border-[var(--error-container)] bg-[var(--error-container)]/50 px-4 py-3 text-sm text-[var(--on-error-container)]"></div>

                <div class="grid gap-6 md:grid-cols-2">
                    <div>
                        <label asp-for="Name" class="mb-2 block text-sm font-semibold text-[var(--on-surface)]">Item Name</label>
                        <input asp-for="Name" class="w-full rounded-xl border border-[var(--outline-variant)] bg-[var(--surface-container)] px-4 py-3 text-sm text-[var(--on-surface)] outline-none transition focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary-fixed-dim)]" placeholder="Enter item name" />
                        <span asp-validation-for="Name" class="mt-2 block text-sm text-[var(--error)]"></span>
                    </div>

                    <div>
                        <label asp-for="Brand" class="mb-2 block text-sm font-semibold text-[var(--on-surface)]">Brand</label>
                        <input asp-for="Brand" class="w-full rounded-xl border border-[var(--outline-variant)] bg-[var(--surface-container)] px-4 py-3 text-sm text-[var(--on-surface)] outline-none transition focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary-fixed-dim)]" placeholder="Enter brand" />
                        <span asp-validation-for="Brand" class="mt-2 block text-sm text-[var(--error)]"></span>
                    </div>

                    <div>
                        <label asp-for="Price" class="mb-2 block text-sm font-semibold text-[var(--on-surface)]">Price (NGN)</label>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="w-full rounded-xl border border-[var(--outline-variant)] bg-[var(--surface-container)] px-4 py-3 text-sm text-[var(--on-surface)] outline-none transition focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary-fixed-dim)]" />
                        <span asp-validation-for="Price" class="mt-2 block text-sm text-[var(--error)]"></span>
                    </div>

                    <div>
                        <label asp-for="QuantityInStock" class="mb-2 block text-sm font-semibold text-[var(--on-surface)]">Quantity In Stock</label>
                        <input asp-for="QuantityInStock" type="number" min="0" class="w-full rounded-xl border border-[var(--outline-variant)] bg-[var(--surface-container)] px-4 py-3 text-sm text-[var(--on-surface)] outline-none transition focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary-fixed-dim)]" />
                        <span asp-validation-for="QuantityInStock" class="mt-2 block text-sm text-[var(--error)]"></span>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label asp-for="Image" class="mb-2 block text-sm font-semibold text-[var(--on-surface)]">Product Image</label>
                        <input asp-for="Image" type="file" accept="image/*" class="block w-full rounded-xl border border-[var(--outline-variant)] bg-[var(--surface-container)] px-4 py-3 text-sm text-[var(--on-surface)] file:mr-4 file:rounded-lg file:border-0 file:bg-[var(--primary)] file:px-4 file:py-2 file:text-sm file:font-semibold file:text-[var(--on-primary)] hover:file:opacity-90" />
                        <p class="mt-2 text-sm text-[var(--on-surface-variant)]">Uploading a new image replaces the current one. JPG, PNG, WEBP, or GIF up to 5MB.</p>
                        <span asp-validation-for="Image" class="mt-2 block text-sm text-[var(--error)]"></span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.CurrentImagePath))
                    {
                        <div class="rounded-2xl border border-[var(--outline-variant)] bg-[var(--surface-container-low)] p-4">
                            <p class="mb-3 text-sm font-semibold text-[var(--on-surface)]">Current Image</p>
                            <img src="@Model.CurrentImagePath" alt="@Model.Name" class="max-h-64 rounded-xl border border-[var(--outline-variant)] object-cover" />
                        </div>
                    }
                </div>

                <div class="flex flex-col gap-3 border-t border-[var(--outline-variant)] pt-6 sm:flex-row sm:justify-end">
                    <a asp-action="Index" asp-controller="Item" class="inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--outline)] px-5 py-3 text-sm font-semibold text-[var(--on-surface-variant)] transition hover:bg-[var(--surface-variant)]">
                        <span class="material-symbols-outlined text-[18px]">close</span>
                        Cancel
                    </a>
                    <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--primary)] px-5 py-3 text-sm font-semibold text-[var(--on-primary)] transition hover:opacity-90">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
