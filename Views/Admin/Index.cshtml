@using EMS.Models.DTOs.Admin
@using EMS.Models.Enums
@model AdminDashboardViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
    ViewData["AdminHeading"] = "Analytics Dashboard";
    ViewData["AdminSubtitle"] = "Track revenue, stock pressure, customer growth, and fulfillment health from one admin surface.";

    string StatusBadgeClasses(Status status) => status switch
    {
        Status.Delivered => "bg-brand-successSoft text-brand-success",
        Status.Processing => "bg-brand-primarySoft text-brand-primary",
        Status.Pending => "bg-brand-accentSoft text-amber-700",
        Status.Cancelled => "bg-brand-dangerSoft text-brand-danger",
        _ => "bg-slate-100 text-slate-700"
    };
}

@section AdminActions {
    <a asp-action="Create" asp-controller="Item" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-brand-primary px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-sky-900 sm:w-auto">
        <span class="material-symbols-outlined text-base">add</span>
        New SKU
    </a>
    <a asp-action="Index" asp-controller="Item" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm font-semibold text-brand-slate shadow-sm transition hover:border-brand-primary hover:text-brand-primary sm:w-auto">
        <span class="material-symbols-outlined text-base">inventory</span>
        Review Stock
    </a>
}

<section class="space-y-6">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-3xl border border-brand-line bg-white p-6 shadow-admin">
            <div class="mb-5 flex items-start justify-between gap-4">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-primarySoft text-brand-primary">
                    <span class="material-symbols-outlined">payments</span>
                </span>
                <span class="rounded-full bg-brand-successSoft px-3 py-1 text-xs font-semibold text-brand-success">
                    @(Model.SalesChangePercentage >= 0 ? "+" : string.Empty)@Model.SalesChangePercentage.ToString("N1")%
                </span>
            </div>
            <p class="text-sm font-medium text-brand-muted">Total Sales</p>
            <h3 class="mt-2 text-3xl font-bold tracking-tight text-brand-ink">&#8358;@Model.TotalSales.ToString("N0")</h3>
            <p class="mt-3 text-sm text-brand-muted">Successful Paystack collections across fulfilled customer payments.</p>
        </article>

        <article class="rounded-3xl border border-brand-line bg-white p-6 shadow-admin">
            <div class="mb-5 flex items-start justify-between gap-4">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-accentSoft text-amber-700">
                    <span class="material-symbols-outlined">pending_actions</span>
                </span>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-brand-slate">@Model.PendingOrdersToday today</span>
            </div>
            <p class="text-sm font-medium text-brand-muted">Pending Orders</p>
            <h3 class="mt-2 text-3xl font-bold tracking-tight text-brand-ink">@Model.PendingOrders</h3>
            <p class="mt-3 text-sm text-brand-muted">Orders still waiting for action from operations.</p>
        </article>

        <article class="rounded-3xl border border-brand-line bg-white p-6 shadow-admin">
            <div class="mb-5 flex items-start justify-between gap-4">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-dangerSoft text-brand-danger">
                    <span class="material-symbols-outlined">warning</span>
                </span>
                <span class="rounded-full bg-brand-dangerSoft px-3 py-1 text-xs font-semibold text-brand-danger">Needs review</span>
            </div>
            <p class="text-sm font-medium text-brand-muted">Low Stock Alerts</p>
            <h3 class="mt-2 text-3xl font-bold tracking-tight text-brand-ink">@Model.LowStockAlerts</h3>
            <p class="mt-3 text-sm text-brand-muted">Products at or below the critical stock threshold.</p>
        </article>

        <article class="rounded-3xl border border-brand-line bg-white p-6 shadow-admin">
            <div class="mb-5 flex items-start justify-between gap-4">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-primarySoft text-brand-primary">
                    <span class="material-symbols-outlined">person_add</span>
                </span>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-brand-slate">@Model.TotalCustomers total</span>
            </div>
            <p class="text-sm font-medium text-brand-muted">New Customers</p>
            <h3 class="mt-2 text-3xl font-bold tracking-tight text-brand-ink">@Model.NewCustomersThisMonth</h3>
            <p class="mt-3 text-sm text-brand-muted">Customers registered during the current month.</p>
        </article>
    </div>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
        <article class="xl:col-span-2 rounded-3xl border border-brand-line bg-white p-6 shadow-admin">
            <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h3 class="text-xl font-bold text-brand-ink">Sales Performance Trends</h3>
                    <p class="mt-1 text-sm text-brand-muted">Daily successful payment totals for the last 7 days.</p>
                </div>
                <div class="rounded-2xl border border-brand-line bg-brand-soft px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted">
                    Last 7 Days
                </div>
            </div>

            <div class="overflow-x-auto rounded-3xl border border-brand-line bg-brand-soft/80 p-5">
                <div class="flex h-72 min-w-[520px] items-end justify-between gap-3 sm:min-w-0">
                    @if (Model.SalesTrend.Any())
                    {
                        foreach (var point in Model.SalesTrend)
                        {
                            <div class="flex min-w-0 flex-1 flex-col items-center gap-3">
                                <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-brand-muted">&#8358;@point.Amount.ToString("N0")</span>
                                <div class="relative flex w-full max-w-[54px] items-end rounded-t-3xl bg-slate-200/80" style="height: 220px;">
                                    <div class="w-full rounded-t-3xl @(point.IsCurrent ? "bg-brand-primary" : "bg-sky-300") transition-all duration-300" style="height:@point.Percentage%"></div>
                                </div>
                                <span class="text-xs font-semibold text-brand-slate">@point.Label</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="flex h-full w-full items-center justify-center rounded-3xl border border-dashed border-brand-line text-sm text-brand-muted">
                            No payment activity available yet.
                        </div>
                    }
                </div>
            </div>
        </article>

        <aside class="rounded-3xl border border-brand-line bg-white p-6 shadow-admin">
            <div class="mb-6">
                <h3 class="text-xl font-bold text-brand-ink">Inventory Status</h3>
                <p class="mt-1 text-sm text-brand-muted">Priority stock watch for the most sensitive product lines.</p>
            </div>

            <div class="space-y-5">
                @if (Model.InventoryStatus.Any())
                {
                    foreach (var item in Model.InventoryStatus)
                    {
                        <div class="space-y-2">
                            <div class="flex items-center justify-between gap-3">
                                <span class="truncate text-sm font-semibold text-brand-slate" title="@item.Label">@item.Label</span>
                                <span class="text-xs font-semibold @(item.IsCritical ? "text-brand-danger" : "text-brand-muted")">@item.QuantityInStock units</span>
                            </div>
                            <div class="h-2.5 overflow-hidden rounded-full bg-slate-200">
                                <div class="h-full rounded-full @(item.IsCritical ? "bg-brand-danger" : "bg-brand-primary")" style="width:@item.Percentage%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="rounded-3xl border border-dashed border-brand-line px-4 py-10 text-center text-sm text-brand-muted">
                        No inventory entries yet.
                    </div>
                }
            </div>

            <div class="mt-6 rounded-3xl bg-brand-soft px-4 py-4 text-sm text-brand-slate">
                @Model.InventoryRecommendation
            </div>

            <div class="mt-6 grid grid-cols-2 gap-3">
                <div class="rounded-2xl border border-brand-line bg-brand-soft px-4 py-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted">Products</p>
                    <p class="mt-2 text-2xl font-bold text-brand-ink">@Model.TotalProducts</p>
                </div>
                <div class="rounded-2xl border border-brand-line bg-brand-soft px-4 py-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted">Units</p>
                    <p class="mt-2 text-2xl font-bold text-brand-ink">@Model.TotalUnitsInStock</p>
                </div>
            </div>
        </aside>
    </div>

    <section class="rounded-3xl border border-brand-line bg-white p-6 shadow-admin">
        <div class="mb-6 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <h3 class="text-xl font-bold text-brand-ink">Recent Orders</h3>
                <p class="mt-1 text-sm text-brand-muted">Latest operational activity flowing through the order queue.</p>
            </div>
            <div class="flex flex-wrap gap-3">
                <div class="rounded-2xl border border-brand-line bg-brand-soft px-4 py-2 text-sm text-brand-slate">Inventory Value: &#8358;@Model.InventoryValue.ToString("N0")</div>
                <a asp-action="Index" asp-controller="Order" class="rounded-2xl border border-brand-line bg-white px-4 py-2 text-sm font-semibold text-brand-primary transition hover:border-brand-primary">
                    View All Orders
                </a>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full border-separate border-spacing-0 overflow-hidden rounded-3xl">
                <thead>
                    <tr>
                        <th class="border-b border-brand-line bg-brand-soft px-5 py-4 text-left text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted">Order ID</th>
                        <th class="border-b border-brand-line bg-brand-soft px-5 py-4 text-left text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted">Customer</th>
                        <th class="border-b border-brand-line bg-brand-soft px-5 py-4 text-left text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted">Products</th>
                        <th class="border-b border-brand-line bg-brand-soft px-5 py-4 text-left text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted">Status</th>
                        <th class="border-b border-brand-line bg-brand-soft px-5 py-4 text-left text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted">Amount</th>
                        <th class="border-b border-brand-line bg-brand-soft px-5 py-4 text-left text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted">Created</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-brand-line">
                    @if (Model.RecentOrders.Any())
                    {
                        foreach (var order in Model.RecentOrders)
                        {
                            <tr class="transition hover:bg-slate-50/80">
                                <td class="px-5 py-4 font-mono text-sm font-semibold text-brand-primary">@order.OrderNumber</td>
                                <td class="px-5 py-4 text-sm font-medium text-brand-slate">@order.CustomerName</td>
                                <td class="px-5 py-4 text-sm text-brand-muted">@order.ProductSummary</td>
                                <td class="px-5 py-4">
                                    <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold @StatusBadgeClasses(order.Status)">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="px-5 py-4 text-sm font-semibold text-brand-ink">&#8358;@order.Amount.ToString("N0")</td>
                                <td class="px-5 py-4 text-sm text-brand-muted">@order.CreatedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-5 py-12 text-center text-sm text-brand-muted">No order activity is available yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
