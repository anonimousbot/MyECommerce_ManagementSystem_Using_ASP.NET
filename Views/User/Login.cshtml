@model EMS.Models.DTOs.Users.LoginRequestModel

@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Sign In";
    var returnUrl = (string?)ViewBag.ReturnUrl ?? string.Empty;
}

<style>
    :root {
        --brand: #6c2bd9;
        --brand-strong: #5521b5;
        --brand-soft: #f3e8ff;
        --ink: #172033;
        --muted: #6b7280;
        --border: rgba(23, 32, 51, 0.12);
        --surface: rgba(255, 255, 255, 0.92);
    }

    body {
        min-height: 100vh;
        padding: 2rem 0;
    }

    .login-container {
        width: 100%;
        max-width: 1080px;
        margin: 2rem auto;
        padding: 0 1.25rem;
    }

    .login-card {
        background: var(--surface);
        border-radius: 30px;
        border: 1px solid var(--border);
        box-shadow: 0 32px 90px rgba(23, 32, 51, 0.14);
        backdrop-filter: blur(14px);
        overflow: hidden;
        animation: slideUp 0.55s ease-out;
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .panel-left {
        background:
            radial-gradient(circle at 20% 18%, rgba(196, 181, 253, 0.24), transparent 24%),
            radial-gradient(circle at 82% 78%, rgba(124, 58, 237, 0.26), transparent 28%),
            linear-gradient(145deg, #1e0744 0%, #3b0f9e 56%, #1b0f31 100%);
        color: white;
        padding: 3rem 2.6rem;
        min-height: 520px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .brand-mark {
        display: inline-flex;
        align-items: center;
        gap: 12px;
    }

    .brand-badge {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: linear-gradient(135deg, #c4b5fd, var(--brand));
        color: #ffffff;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 16px 36px rgba(108, 43, 217, 0.28);
    }

    .panel-left h1 {
        font-size: 2.35rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        margin-top: 1.4rem;
        max-width: 10ch;
    }

    .panel-left p {
        color: rgba(255,255,255,0.78);
        margin: 0.85rem 0 0 0;
        max-width: 34ch;
        line-height: 1.7;
    }

    .perk {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        color: rgba(255,255,255,0.88);
        font-weight: 600;
    }

    .perk i {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.12);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
    }

    .panel-right {
        padding: 2.75rem 2.4rem;
        background:
            linear-gradient(180deg, rgba(255,255,255,0.94), rgba(255,255,255,0.90)),
            linear-gradient(135deg, rgba(243, 232, 255, 0.66), rgba(255,255,255,0.30));
    }

    .title {
        font-size: 1.8rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        margin-bottom: 0.25rem;
        color: var(--ink);
    }

    .subtitle {
        color: var(--muted);
        margin-bottom: 1.5rem;
    }

    .form-control {
        border: 1.5px solid var(--border);
        border-radius: 16px;
        padding: 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: rgba(255,255,255,0.96);
    }

    .form-control:focus {
        border-color: rgba(108, 43, 217, 0.58);
        box-shadow: 0 0 0 4px rgba(108, 43, 217, 0.12);
        background: #fff;
        outline: none;
    }

    .form-label {
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 0.5rem;
        display: block;
        font-size: 0.9rem;
    }

    .input-group-icon {
        position: relative;
    }

    .field-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
        z-index: 5;
        pointer-events: none;
    }

    .input-group-icon .form-control {
        padding-left: 2.75rem;
        padding-right: 3.5rem;
    }

    .toggle-pass {
        position: absolute;
        right: 0.65rem;
        top: 50%;
        transform: translateY(-50%);
        border: 0;
        background: transparent;
        z-index: 6;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        color: var(--muted);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease, color 0.2s ease;
        padding: 0;
    }

    .toggle-pass:hover {
        background: rgba(23, 32, 51, 0.06);
        color: var(--ink);
    }

    .toggle-pass i {
        position: static;
        transform: none;
        color: inherit;
        pointer-events: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, #7c3aed, var(--brand-strong));
        border: none;
        border-radius: 16px;
        padding: 1rem;
        font-size: 1rem;
        font-weight: 900;
        width: 100%;
        transition: all 0.3s ease;
        color: #ffffff;
        box-shadow: 0 16px 38px rgba(108, 43, 217, 0.24);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 20px 44px rgba(108, 43, 217, 0.34);
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 1.5rem 0;
    }

    .divider::before,
    .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid var(--border);
    }

    .divider span {
        padding: 0 1rem;
        color: var(--muted);
        font-size: 0.875rem;
        font-weight: 800;
    }

    .btn-google {
        background: rgba(255,255,255,0.96);
        border: 1.5px solid var(--border);
        border-radius: 16px;
        padding: 0.95rem;
        font-size: 1rem;
        font-weight: 900;
        width: 100%;
        color: var(--ink);
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
    }

    .btn-google:hover {
        border-color: rgba(108, 43, 217, 0.28);
        background: var(--brand-soft);
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(23, 32, 51, 0.10);
        text-decoration: none;
        color: var(--ink);
    }

    .alert {
        border-radius: 14px;
        border: none;
        padding: 1rem;
        margin-bottom: 1.5rem;
        animation: shake 0.45s ease-out;
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-8px); }
        75% { transform: translateX(8px); }
    }

    .create-account-link {
        text-align: center;
        margin-top: 1.5rem;
        color: var(--muted);
        font-size: 0.9rem;
    }

    .create-account-link a {
        color: var(--ink);
        font-weight: 900;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .create-account-link a:hover {
        color: var(--brand-strong);
        text-decoration: underline;
    }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .forgot-password {
        text-align: right;
        margin-top: -0.5rem;
        margin-bottom: 1rem;
    }

    .forgot-password a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 800;
        transition: color 0.3s ease;
    }

    .forgot-password a:hover {
        color: var(--ink);
        text-decoration: underline;
    }

    @@media (max-width: 576px) {
        .panel-right { padding: 1.75rem 1.5rem; }
    }
</style>

<div class="login-container">
    <div class="login-card">
        <div class="row g-0">
            <div class="col-lg-6 d-none d-lg-block">
                <div class="panel-left">
                    <div>
                        <div class="brand-mark">
                            <span class="brand-badge">TS</span>
                            <div>
                                <div class="fw-bold">T-Socket Gadgets</div>
                                <div class="small" style="color: rgba(255,255,255,0.75);">Simple, trusted shopping</div>
                            </div>
                        </div>

                        <h1>Sign in and pick up where you left off.</h1>
                        @* <p>Use the same purple T-Socket look from the storefront, then move straight into cart, checkout, and order tracking.</p> *@

                        <div class="mt-4">
                            <div class="perk"><i class="bi bi-shield-lock"></i> Secure customer accounts</div>
                            <div class="perk"><i class="bi bi-truck"></i> Delivery tracking</div>
                            <div class="perk"><i class="bi bi-bag-check"></i> Order history and receipts</div>
                        </div>
                    </div>

                    <div class="small" style="color: rgba(255,255,255,0.70);">
                        Need an account? <a class="text-white fw-bold" asp-controller="Customer" asp-action="Create">Create one</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="panel-right">
                    <div class="title">Welcome back</div>
                    <div class="subtitle">Sign in to continue to T-Socket Gadgets.</div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
                        </div>
                    }

                    <form asp-controller="User" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email address</label>
                            <div class="input-group-icon">
                                <i class="bi bi-envelope field-icon"></i>
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="Password" class="form-label">Password</label>
                            <div class="input-group-icon">
                                <i class="bi bi-lock field-icon"></i>
                                <input asp-for="Password" id="password-input" type="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" />
                                <button type="button" class="toggle-pass" id="toggle-pass" aria-label="Toggle password visibility">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="forgot-password">
                            <a href="#">Forgot Password?</a>
                        </div>

                        <button type="submit" class="btn btn-primary">Continue</button>
                    </form>

                    <div class="divider">
                        <span>OR</span>
                    </div>

                    <a asp-controller="User" asp-action="GoogleLogin" asp-route-returnUrl="@returnUrl" class="btn-google">
                        <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                        </svg>
                        Continue with Google
                    </a>

                    <div class="create-account-link">
                        Don&apos;t have an account? <a asp-controller="Customer" asp-action="Create">Create one</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const input = document.getElementById('password-input');
            const button = document.getElementById('toggle-pass');
            if (!input || !button) return;

            button.addEventListener('click', function () {
                const isHidden = input.getAttribute('type') === 'password';
                input.setAttribute('type', isHidden ? 'text' : 'password');
                const icon = button.querySelector('i');
                if (icon) {
                    icon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
                }
            });
        })();
    </script>
}
