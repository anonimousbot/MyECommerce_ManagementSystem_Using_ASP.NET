@using EMS.Models.DTOs
@model BaseResponse<EMS.Models.DTOs.Carts.CartDto>

@{
    ViewBag.Title = "My Cart";
    var cart = Model?.Data;
}

<div class="page-heading">
    <div>
        <h1 class="page-title">My cart</h1>
        <p class="page-subtitle">Review your picks, update quantities, and move smoothly into checkout.</p>
    </div>
    <div class="page-action-row">
        <a asp-action="Index" asp-controller="Customer" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Continue shopping
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">@TempData["Success"]</div>
}

@if (cart == null || cart.Items.Count == 0)
{
    <div class="empty-state-card">
        <div class="empty-state-icon"><i class="bi bi-bag-x"></i></div>
        <h2 class="page-title" style="font-size:1.4rem;">Your cart is empty</h2>
        <p class="page-subtitle">Pick a few gadgets first, then come back here to check out.</p>
        <a asp-action="Index" asp-controller="Customer" class="btn btn-primary mt-3">
            <i class="bi bi-grid me-2"></i>Browse items
        </a>
    </div>
}
else
{
    <div class="metric-grid">
        <div class="metric-card">
            <div class="metric-label"><i class="bi bi-bag-check"></i>Cart Items</div>
            <div class="metric-value">@cart.Items.Count</div>
        </div>
        <div class="metric-card">
            <div class="metric-label"><i class="bi bi-cash-stack"></i>Subtotal</div>
            <div class="metric-value">₦@cart.Subtotal.ToString("N2")</div>
        </div>
    </div>

    <div class="section-shell">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Unit Price</th>
                        <th style="width: 220px;">Quantity</th>
                        <th>Total</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in cart.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@item.Name</div>
                                <div class="text-muted small">@item.Brand</div>
                            </td>
                            <td class="fw-semibold text-dark">₦@item.UnitPrice.ToString("N2")</td>
                            <td>
                                <form asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="itemId" value="@item.ItemId" />
                                    <input type="number" name="quantity" min="1" class="form-control" value="@item.Quantity" />
                                    <button type="submit" class="btn btn-outline-secondary">Update</button>
                                </form>
                            </td>
                            <td class="fw-bold text-dark">₦@item.Total.ToString("N2")</td>
                            <td class="text-end">
                                <form asp-action="Remove" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="itemId" value="@item.ItemId" />
                                    <button type="submit" class="btn btn-outline-danger">
                                        <i class="bi bi-trash3 me-2"></i>Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <div class="card" style="max-width: 360px; width: 100%;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-semibold">Subtotal</span>
                        <span class="fw-bold fs-5 text-dark">₦@cart.Subtotal.ToString("N2")</span>
                    </div>
                    <a asp-action="Checkout" class="btn btn-primary w-100">
                        <i class="bi bi-credit-card-2-front me-2"></i>Checkout with Paystack
                    </a>
                </div>
            </div>
        </div>
    </div>
}
