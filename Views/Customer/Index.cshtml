@using EMS.Models.DTOs
@using EMS.Models.Enums

@model BaseResponse<IEnumerable<EMS.Models.DTOs.Items.ItemDto>>
@{
    ViewBag.Title = "Available Items";
}

<h2 class="mb-4"><i class="bi bi-shop"></i> Available Items</h2>

<!-- Search and Filter Section -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Index" method="get" asp-controller="Customer">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="search" 
                                       class="form-control" 
                                       name="searchString" 
                                       placeholder="Search items..." 
                                       value="@ViewBag.CurrentSearch"
                                       aria-label="Search"/>
                            </div>
                        </div>
                        
                        @* <div class="col-md-3">
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-funnel-fill"></i>
                                </span>


                                <select class="form-select" name="BrandEnum" asp-items="@Html.GetEnumSelectList(typeof(BrandEnum))" required>
                                    </select>
                               
                            </div>
                        </div> *@
                        
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-dark me-2">
                                <i class="bi bi-check-circle"></i> Apply
                            </button>
                            <a asp-action="Index" asp-controller="Customer" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Active Filters Badge -->
@* @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || !string.IsNullOrEmpty(ViewBag.CurrentBrand))
{
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle-fill"></i> <strong>Active Filters:</strong>
        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
        {
            <span class="badge bg-primary"><i class="bi bi-search"></i> "@ViewBag.CurrentSearch"</span>
        }
        @if (!string.IsNullOrEmpty(ViewBag.CurrentBrand))
        {
            <span class="badge bg-success"><i class="bi bi-tag-fill"></i> @ViewBag.CurrentBrand</span>
        }
    </div>
} *@

<!-- Items Grid -->
<div class="row">
    @if (Model?.Data != null && Model.Data.Any())
    {
        foreach (var item in Model.Data)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 text-center p-3 shadow-sm hover-shadow">
                    <!-- Item Icon -->
                    <div class="mb-3">
                        <i class="bi bi-box-seam text-primary" style="font-size: 3rem;"></i>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-box"></i> @item.Name
                        </h5>
                        <p class="text-muted mb-2">
                            <span class="badge bg-info text-dark">
                                <i class="bi bi-bookmark-fill"></i> @item.Brand
                            </span>
                        </p>
                        <p class="card-text fs-5 fw-bold text-success">
                            <i class="bi bi-currency-exchange"></i> @item.Price.ToString("C")
                        </p>
                        <a asp-action="CreateOrder" 
                           asp-controller="Order" 
                           asp-route-itemId="@item.Id" 
                           class="btn btn-primary">
                            <i class="bi bi-cart-plus"></i> Place Order
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-warning text-center" role="alert">
                <i class="bi bi-exclamation-triangle fs-1"></i>
                <p class="mt-3 mb-2">
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || !string.IsNullOrEmpty(ViewBag.CurrentBrand))
                    {
                        <strong>No items found matching your filters.</strong>
                    }
                    else
                    {
                        <strong>No items available at the moment.</strong>
                    }
                </p>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || !string.IsNullOrEmpty(ViewBag.CurrentBrand))
                {
                    <a asp-action="Index" asp-controller="Customer" class="btn btn-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Clear Filters
                    </a>
                }
            </div>
        </div>
    }
</div>

<!-- Custom hover effect for cards -->
<style>
    .hover-shadow {
        transition: all 0.3s ease;
    }
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>
<!-- Include Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">