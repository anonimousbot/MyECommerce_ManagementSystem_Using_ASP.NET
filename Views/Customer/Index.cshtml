@using EMS.Models.DTOs
@model BaseResponse<IEnumerable<EMS.Models.DTOs.Items.ItemDto>>

@{
    ViewBag.Title = "Shop Items";
    var items = Model?.Data?.ToList() ?? [];
    var search = (string?)ViewBag.CurrentSearch ?? string.Empty;
    var returnUrl = $"{ViewContext.HttpContext.Request.Path}{ViewContext.HttpContext.Request.QueryString}";
}

<style>
    .customer-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        padding: 2.2rem 2rem;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, #1e0744 0%, #5521b5 42%, #7c3aed 100%);
        color: #fff;
        box-shadow: 0 28px 60px rgba(108, 43, 217, 0.22);
    }

    .customer-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(255,255,255,0.18), transparent 35%);
        pointer-events: none;
    }

    .customer-hero > * {
        position: relative;
        z-index: 1;
    }

    .customer-hero h1 {
        margin: 0;
        font-size: clamp(1.85rem, 2.5vw, 2.4rem);
        font-weight: 900;
        letter-spacing: -0.05em;
    }

    .customer-hero p {
        margin: 0.75rem 0 0;
        max-width: 58ch;
        color: rgba(255,255,255,0.78);
        line-height: 1.7;
    }

    .shop-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(245px, 1fr));
        gap: 1rem;
    }

    .shop-card {
        height: 100%;
        background: rgba(255,255,255,0.96);
        border: 1px solid rgba(15,23,42,0.08);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 18px 40px rgba(15,23,42,0.08);
        transition: transform 0.22s ease, box-shadow 0.22s ease;
    }

    .shop-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 24px 52px rgba(108,43,217,0.16);
    }

    .shop-card-media {
        aspect-ratio: 1 / 1;
        background: linear-gradient(180deg, #f8f7ff 0%, #f1f5f9 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .shop-card-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .shop-card-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        color: #94a3b8;
    }

    .shop-card-placeholder i {
        font-size: 2rem;
    }

    .shop-card-body {
        padding: 1rem 1rem 1.1rem;
    }

    .shop-card-brand {
        color: #6c2bd9;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .shop-card-name {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 800;
        margin-top: 0.35rem;
        line-height: 1.45;
        min-height: 2.8em;
    }

    .shop-card-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0.85rem 0 1rem;
    }

    .shop-card-price {
        color: #0f172a;
        font-size: 1.18rem;
        font-weight: 900;
        letter-spacing: -0.03em;
    }

    .stock-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        padding: 0.42rem 0.7rem;
        font-size: 0.76rem;
        font-weight: 800;
    }

    .stock-chip.ok {
        background: rgba(22,163,74,0.08);
        color: #15803d;
    }

    .stock-chip.low {
        background: rgba(220,38,38,0.08);
        color: #b91c1c;
    }
</style>

<section class="customer-hero">
    <div class="page-heading mb-0">
        <div>
            <h1>Shop the customer collection</h1>
            <p>Explore the same curated T-Socket catalog with a cleaner browsing flow, faster cart actions, and a more polished product grid.</p>
        </div>
        <div class="page-action-row">
            <a asp-action="Index" asp-controller="Cart" class="btn btn-light">
                <i class="bi bi-bag me-2"></i>Open cart
            </a>
        </div>
    </div>
</section>

<div class="ts-filter-card mb-4">
    <form asp-action="Index" method="get" asp-controller="Customer">
        <div class="row g-3 align-items-end">
            <div class="col-lg-8">
                <label class="form-label" for="searchString">Search items</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input id="searchString"
                           type="search"
                           class="form-control"
                           name="searchString"
                           placeholder="Search by product or brand"
                           value="@search"
                           aria-label="Search items" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="page-action-row">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-sliders me-2"></i>Apply filters
                    </button>
                    <a asp-action="Index" asp-controller="Customer" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Reset
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@if (items.Count == 0)
{
    <div class="empty-state-card">
        <div class="empty-state-icon"><i class="bi bi-inbox"></i></div>
        <h3 class="page-title" style="font-size:1.4rem;">No items matched this search</h3>
        <p class="page-subtitle">
            @(string.IsNullOrWhiteSpace(search)
                ? "There are no customer-facing products available right now."
                : $"Nothing matched \"{search}\" yet. Try a broader search term.")
        </p>
        <a asp-action="Index" asp-controller="Customer" class="btn btn-primary mt-3">
            <i class="bi bi-arrow-repeat me-2"></i>Browse all items
        </a>
    </div>
}
else
{
    <div class="shop-grid">
        @foreach (var item in items)
        {
            var stockOk = item.QuantityInStock > 5;

            <article class="shop-card">
                <div class="shop-card-media">
                    @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                    {
                        <img src="@item.ImagePath" alt="@item.Name" />
                    }
                    else
                    {
                        <div class="shop-card-placeholder">
                            <i class="bi bi-image"></i>
                            <span>No image</span>
                        </div>
                    }
                </div>
                <div class="shop-card-body">
                    <div class="shop-card-brand">@item.Brand</div>
                    <div class="shop-card-name">@item.Name</div>
                    <div class="shop-card-meta">
                        <div class="shop-card-price">₦@item.Price.ToString("N2")</div>
                        <span class="stock-chip @(stockOk ? "ok" : "low")">
                            <i class="bi @(stockOk ? "bi-check-circle" : "bi-exclamation-circle")"></i>
                            @(stockOk ? "In stock" : "Low stock")
                        </span>
                    </div>
                    <form asp-action="AddToCart" asp-controller="Cart" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-bag-plus me-2"></i>Add to cart
                        </button>
                    </form>
                </div>
            </article>
        }
    </div>
}

@if (Model?.Pagination != null && Model.Pagination.TotalPages > 1)
{
    <nav aria-label="Item pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Pagination.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-controller="Customer"
                   asp-route-searchString="@search"
                   asp-route-pageNumber="@(Model.Pagination.PageNumber - 1)"
                   asp-route-pageSize="@Model.Pagination.PageSize">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.Pagination.PageNumber</span>
            </li>
            <li class="page-item @(Model.Pagination.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-controller="Customer"
                   asp-route-searchString="@search"
                   asp-route-pageNumber="@(Model.Pagination.PageNumber + 1)"
                   asp-route-pageSize="@Model.Pagination.PageSize">Next</a>
            </li>
        </ul>
    </nav>
}
