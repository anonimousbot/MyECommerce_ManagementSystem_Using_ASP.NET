@using EMS.Models.DTOs
@model BaseResponse<EMS.Models.DTOs.Users.UserDto>

@{
    ViewData["Title"] = "My Profile";
    var user = Model?.Data;
    var customer = user?.Customer;
    var displayName = customer?.FullName;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = customer == null
            ? "Customer"
            : string.Join(" ", new[] { customer.FirstName, customer.LastName }.Where(x => !string.IsNullOrWhiteSpace(x))).Trim();
    }

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = user?.Email ?? "Customer";
    }

    var initials = string.Join("", displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "C";
    }
}

<style>
    .profile-shell {
        display: grid;
        gap: 1.5rem;
    }

    .profile-hero {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        padding: 2rem;
        background: linear-gradient(135deg, #1e0744 0%, #5521b5 42%, #7c3aed 100%);
        color: #fff;
        box-shadow: 0 26px 56px rgba(108, 43, 217, 0.22);
    }

    .profile-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at top right, rgba(255,255,255,0.16), transparent 28%),
            radial-gradient(circle at bottom left, rgba(255,255,255,0.12), transparent 24%);
        pointer-events: none;
    }

    .profile-hero > * {
        position: relative;
        z-index: 1;
    }

    .profile-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
    }

    .profile-identity {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .profile-avatar {
        width: 88px;
        height: 88px;
        border-radius: 24px;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.24);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        font-weight: 900;
        letter-spacing: -0.05em;
        box-shadow: 0 18px 36px rgba(15,23,42,0.18);
        backdrop-filter: blur(10px);
        flex-shrink: 0;
    }

    .profile-name {
        margin: 0;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        font-weight: 900;
        letter-spacing: -0.05em;
    }

    .profile-copy {
        margin: 0.45rem 0 0;
        color: rgba(255,255,255,0.78);
        max-width: 58ch;
        line-height: 1.7;
    }

    .profile-role-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 1rem;
    }

    .profile-role {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.48rem 0.78rem;
        border-radius: 999px;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.18);
        color: #fff;
        font-size: 0.8rem;
        font-weight: 800;
    }

    .profile-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .profile-actions .btn {
        min-width: 150px;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
    }

    .profile-card {
        background: rgba(255,255,255,0.95);
        border: 1px solid rgba(15,23,42,0.08);
        border-radius: 24px;
        box-shadow: 0 18px 40px rgba(15,23,42,0.08);
        padding: 1.5rem;
    }

    .profile-card-title {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin: 0 0 1.3rem;
        color: #0f172a;
        font-size: 1.12rem;
        font-weight: 900;
        letter-spacing: -0.03em;
    }

    .profile-card-title i {
        color: #6c2bd9;
    }

    .profile-field {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        padding: 0.95rem 0;
        border-top: 1px solid rgba(15,23,42,0.06);
    }

    .profile-field:first-of-type {
        border-top: 0;
        padding-top: 0;
    }

    .profile-field-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(108,43,217,0.1);
        color: #6c2bd9;
        flex-shrink: 0;
    }

    .profile-field-label {
        margin: 0 0 0.2rem;
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .profile-field-value {
        margin: 0;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.55;
        word-break: break-word;
    }

    .profile-status {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.5rem 0.85rem;
        border-radius: 999px;
        background: rgba(22,163,74,0.1);
        color: #15803d;
        font-size: 0.84rem;
        font-weight: 800;
    }

    .profile-empty {
        text-align: center;
        padding: 3rem 1.5rem;
    }

    @@media (max-width: 991px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .profile-hero {
            padding: 1.35rem;
        }

        .profile-identity {
            align-items: flex-start;
        }

        .profile-avatar {
            width: 72px;
            height: 72px;
            border-radius: 20px;
            font-size: 1.5rem;
        }

        .profile-actions {
            width: 100%;
        }

        .profile-actions .btn {
            width: 100%;
        }
    }
</style>

@if (user == null || customer == null)
{
    <div class="empty-state-card profile-empty">
        <div class="empty-state-icon"><i class="bi bi-person-x"></i></div>
        <h2 class="page-title" style="font-size:1.45rem;">Profile not available</h2>
        <p class="page-subtitle">We could not load your profile details right now. Please try again from your dashboard.</p>
        <a asp-action="Index" asp-controller="Customer" class="btn btn-primary mt-3">
            <i class="bi bi-arrow-left me-2"></i>Back to dashboard
        </a>
    </div>
}
else
{
    <div class="profile-shell">
        <section class="profile-hero">
            <div class="profile-top">
                <div>
                    <div class="profile-identity">
                        <div class="profile-avatar">@initials</div>
                        <div>
                            <h1 class="profile-name">@displayName</h1>
                            <p class="profile-copy">Keep your contact details current so checkout, delivery, and account activity stay accurate across your T-Socket experience.</p>
                        </div>
                    </div>

                    @if (user.Roles != null && user.Roles.Any())
                    {
                        <div class="profile-role-list">
                            @foreach (var role in user.Roles)
                            {
                                <span class="profile-role">
                                    <i class="bi bi-shield-check"></i>@role.Name
                                </span>
                            }
                        </div>
                    }
                </div>

                <div class="profile-actions">
                    <a class="btn btn-light" asp-action="Index" asp-controller="Customer">
                        <i class="bi bi-arrow-left me-2"></i>Back to shop
                    </a>
                    <a class="btn btn-primary"
                       asp-action="Update"
                       asp-route-id="@customer.Id"
                       asp-controller="Customer">
                        <i class="bi bi-pencil-square me-2"></i>Edit profile
                    </a>
                    <a class="btn btn-outline-danger"
                       asp-action="Delete"
                       asp-route-id="@customer.Id"
                       asp-controller="Customer"
                       onclick="return confirm('Are you sure you want to remove this account? This action cannot be undone.');">
                        <i class="bi bi-trash3 me-2"></i>Delete account
                    </a>
                </div>
            </div>
        </section>

        <div class="profile-grid">
            <section class="profile-card">
                <h2 class="profile-card-title"><i class="bi bi-telephone-fill"></i>Contact Information</h2>

                <div class="profile-field">
                    <div class="profile-field-icon"><i class="bi bi-envelope-fill"></i></div>
                    <div>
                        <p class="profile-field-label">Email Address</p>
                        <p class="profile-field-value">@user.Email</p>
                    </div>
                </div>

                <div class="profile-field">
                    <div class="profile-field-icon"><i class="bi bi-phone-fill"></i></div>
                    <div>
                        <p class="profile-field-label">Phone Number</p>
                        <p class="profile-field-value">@(string.IsNullOrWhiteSpace(customer.PhoneNumber) ? "Not provided" : customer.PhoneNumber)</p>
                    </div>
                </div>

                <div class="profile-field">
                    <div class="profile-field-icon"><i class="bi bi-geo-alt-fill"></i></div>
                    <div>
                        <p class="profile-field-label">Address</p>
                        <p class="profile-field-value">@(string.IsNullOrWhiteSpace(customer.Address) ? "Not provided" : customer.Address)</p>
                    </div>
                </div>
            </section>

            <section class="profile-card">
                <h2 class="profile-card-title"><i class="bi bi-person-badge-fill"></i>Personal Information</h2>

                <div class="profile-field">
                    <div class="profile-field-icon"><i class="bi bi-person-fill"></i></div>
                    <div>
                        <p class="profile-field-label">Full Name</p>
                        <p class="profile-field-value">@displayName</p>
                    </div>
                </div>

                <div class="profile-field">
                    <div class="profile-field-icon"><i class="bi bi-gender-ambiguous"></i></div>
                    <div>
                        <p class="profile-field-label">Gender</p>
                        <p class="profile-field-value">@(customer.Gender?.ToString() ?? "Not provided")</p>
                    </div>
                </div>

                <div class="profile-field">
                    <div class="profile-field-icon"><i class="bi bi-calendar-event-fill"></i></div>
                    <div>
                        <p class="profile-field-label">Date of Birth</p>
                        <p class="profile-field-value">@(customer.DateOfBirth?.ToString("dd MMM yyyy") ?? "Not provided")</p>
                    </div>
                </div>
            </section>
        </div>

        <section class="profile-card">
            <h2 class="profile-card-title"><i class="bi bi-gear-fill"></i>Account Details</h2>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="profile-field">
                        <div class="profile-field-icon"><i class="bi bi-check-circle-fill"></i></div>
                        <div>
                            <p class="profile-field-label">Account Status</p>
                            <div class="profile-field-value">
                                <span class="profile-status">
                                    <i class="bi bi-circle-fill" style="font-size:0.5rem;"></i>Active
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="profile-field">
                        <div class="profile-field-icon"><i class="bi bi-calendar-plus-fill"></i></div>
                        <div>
                            <p class="profile-field-label">Member Since</p>
                            <p class="profile-field-value">@customer.DateCreated.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="profile-field">
                        <div class="profile-field-icon"><i class="bi bi-clock-history"></i></div>
                        <div>
                            <p class="profile-field-label">Last Updated</p>
                            <p class="profile-field-value">@customer.DateModified.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
}
