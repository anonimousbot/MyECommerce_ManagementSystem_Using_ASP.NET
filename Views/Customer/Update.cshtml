@model EMS.Models.DTOs.Customers.UpdateCustomerRequestModel
@{
    ViewData["Title"] = "Edit Profile";
}

<style>
    :root {
        --ems-indigo: #7c3aed;
        --ems-purple-dark: #5521b5;
        --ems-glass: rgba(255, 255, 255, 0.95);
        --ems-transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    /* --- Page Entrance Animations --- */
    @@keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateY(40px);
            filter: blur(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }

    @@keyframes staggeredReveal {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .animate-page {
        animation: slideUpFade 0.8s var(--ems-transition) forwards;
    }

    /* --- The Modern Card --- */
    .edit-profile-card {
        background: var(--ems-glass);
        backdrop-filter: blur(10px);
        border-radius: 30px;
        border: 1px solid rgba(99, 102, 241, 0.1);
        box-shadow: 0 25px 50px -12px rgba(79, 70, 229, 0.15);
        overflow: hidden;
        margin-top: 2rem;
    }

    /* Banner matching your sidebar purple */
    .profile-banner {
        background: linear-gradient(135deg, var(--ems-indigo), var(--ems-purple-dark));
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
    }

    /* Floating Avatar */
    .avatar-ring {
        width: 110px;
        height: 110px;
        background: white;
        margin: -55px auto 20px;
        border-radius: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.8rem;
        font-weight: 800;
        color: var(--ems-indigo);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        border: 4px solid white;
        position: relative;
        z-index: 2;
        transition: transform 0.3s ease;
    }

        .avatar-ring:hover {
            transform: scale(1.05) rotate(5deg);
        }

    /* --- Form Styling --- */
    .form-label {
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #64748b;
        margin-bottom: 8px;
        margin-left: 4px;
    }

    .ems-input {
        border: 2px solid #f1f5f9;
        border-radius: 16px;
        padding: 14px 20px;
        transition: var(--ems-transition);
        background: #f8fafc;
    }

        .ems-input:focus {
            background: white;
            border-color: var(--ems-indigo);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
            transform: translateY(-2px);
        }

    /* --- Staggered Fields --- */
    .field-group {
        opacity: 0;
        animation: staggeredReveal 0.5s ease forwards;
    }

    .delay-1 {
        animation-delay: 0.1s;
    }

    .delay-2 {
        animation-delay: 0.2s;
    }

    .delay-3 {
        animation-delay: 0.3s;
    }

    .delay-4 {
        animation-delay: 0.4s;
    }

    .delay-5 {
        animation-delay: 0.5s;
    }

    /* --- Buttons --- */
    .btn-save-elite {
        background: linear-gradient(135deg, var(--ems-indigo), var(--ems-purple-dark));
        color: white;
        border: none;
        padding: 16px 35px;
        border-radius: 18px;
        font-weight: 700;
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
        transition: var(--ems-transition);
    }

        .btn-save-elite:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 15px 30px rgba(99, 102, 241, 0.4);
            color: white;
        }

    .btn-cancel-elite {
        background: #f1f5f9;
        color: #64748b;
        border: none;
        padding: 16px 25px;
        border-radius: 18px;
        font-weight: 600;
        transition: var(--ems-transition);
    }

        .btn-cancel-elite:hover {
            background: #e2e8f0;
            color: #1e293b;
        }
</style>

<div class="container animate-page">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="edit-profile-card">

                <div class="profile-banner">
                    <div>
                        <h2 class="fw-bold mb-0">Update Profile</h2>
                        <p class="opacity-75 small">Manage your EMS personal credentials</p>
                    </div>
                </div>

                <div class="avatar-ring">
                    @if (!string.IsNullOrEmpty(Model?.FirstName))
                    {
                        @Model.FirstName.Substring(0, 1)
                    }
                    else
                    {
                        <i class="bi bi-person-circle"></i>
                    }
                </div>

                <div class="card-body px-4 px-md-5 pb-5">
                    <form asp-action="Update" asp-controller="Customer" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        <div class="row g-4">
                            <div class="col-md-6 field-group delay-1">
                                <label asp-for="FirstName" class="form-label">First Name</label>
                                <input asp-for="FirstName" class="form-control ems-input" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 field-group delay-2">
                                <label asp-for="LastName" class="form-label">Last Name</label>
                                <input asp-for="LastName" class="form-control ems-input" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-12 field-group delay-3">
                                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text border-0 bg-transparent text-muted"><i class="bi bi-telephone-plus"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control ems-input border-start" placeholder="+234 XXX XXX XXXX" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-12 field-group delay-4">
                                <label asp-for="Address" class="form-label">Residential Address</label>
                                <textarea asp-for="Address" class="form-control ems-input" rows="3" placeholder="Enter full address"></textarea>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="col-12 field-group delay-5">
                                <label asp-for="Gender" class="form-label">Gender</label>
                                <select asp-for="Gender" class="form-select ems-input">
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5 pt-3">
                            <a asp-action="Index" class="btn-cancel-elite">
                                <i class="bi bi-arrow-left me-2"></i>Discard
                            </a>
                            <button type="submit" class="btn-save-elite">
                                <i class="bi bi-cloud-check me-2"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
