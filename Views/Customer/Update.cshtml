@model EMS.Models.DTOs.Customers.UpdateCustomerRequestModel
@{
    ViewData ["Title"] = "Edit Profile";
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user-edit"></i> Edit Customer Profile
                    </h4>
                </div>
                <div class="card-body">
                    
