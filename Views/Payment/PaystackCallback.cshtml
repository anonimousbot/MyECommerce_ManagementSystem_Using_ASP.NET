@using EMS.Models.DTOs
@model BaseResponse<EMS.Models.DTOs.Payments.PaymentVerificationResultDto>

@{
    ViewBag.Title = "Payment Result";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-body text-center">
            @if (Model?.Data != null && Model.Data.Paid)
            {
                <h3 class="text-success mb-3"><i class="fas fa-check-circle me-2"></i>Payment Successful</h3>
                <p class="text-muted mb-4">Reference: <span class="fw-bold">@Model.Data.Reference</span></p>
                <a asp-action="GetOrdersByCustomerId" asp-controller="Order" class="btn btn-primary">
                    <i class="fas fa-list me-2"></i>View My Orders
                </a>
            }
            else
            {
                <h3 class="text-danger mb-3"><i class="fas fa-times-circle me-2"></i>Payment Not Successful</h3>
                <p class="text-muted mb-2">@Model?.Message</p>
                <p class="text-muted mb-4">Reference: <span class="fw-bold">@Model?.Data?.Reference</span></p>
                <a asp-action="Index" asp-controller="Cart" class="btn btn-outline-dark">
                    <i class="fas fa-shopping-cart me-2"></i>Back to Cart
                </a>
            }
        </div>
    </div>
</div>

