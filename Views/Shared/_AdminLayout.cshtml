@{
    var title = ViewData["Title"] as string ?? ViewBag.Title ?? "Admin Dashboard";
    var adminHeading = ViewData["AdminHeading"] as string ?? title;
    var adminSubtitle = ViewData["AdminSubtitle"] as string ?? "Monitor inventory, orders, customers, and revenue from one operational workspace.";
    var currentPath = (Context?.Request?.Path.Value ?? string.Empty).ToLowerInvariant();
    var year = DateTime.UtcNow.Year;

    var isDashboard = currentPath == "/admin" || currentPath == "/admin/index";
    var isProducts = currentPath.StartsWith("/item");
    var isCustomers = currentPath.StartsWith("/customer/getallcustomer") || currentPath.StartsWith("/customer/getcustomerbyid");
    var isOrders = currentPath.StartsWith("/order");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title | EMS Solutions</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            ink: "#0f172a",
                            slate: "#334155",
                            muted: "#64748b",
                            line: "#d7dee8",
                            panel: "#ffffff",
                            soft: "#f8fafc",
                            shell: "#eef4fb",
                            primary: "#0f4c81",
                            primarySoft: "#dceeff",
                            accent: "#f59e0b",
                            accentSoft: "#fef3c7",
                            success: "#15803d",
                            successSoft: "#dcfce7",
                            danger: "#b91c1c",
                            dangerSoft: "#fee2e2"
                        }
                    },
                    fontFamily: {
                        sans: ["Inter", "sans-serif"],
                        mono: ["JetBrains Mono", "monospace"]
                    },
                    boxShadow: {
                        admin: "0 18px 45px rgba(15, 23, 42, 0.08)",
                        nav: "0 30px 60px rgba(15, 23, 42, 0.14)"
                    },
                    maxWidth: {
                        shell: "1280px"
                    }
                }
            }
        };
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,500,0,0&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: "Inter", sans-serif;
            background:
                radial-gradient(circle at top left, rgba(15, 76, 129, 0.12), transparent 24%),
                radial-gradient(circle at bottom right, rgba(245, 158, 11, 0.08), transparent 20%),
                #eef4fb;
            color: #0f172a;
        }

        .material-symbols-outlined {
            font-variation-settings: "FILL" 0, "wght" 500, "GRAD" 0, "opsz" 24;
        }

        .admin-scroll::-webkit-scrollbar {
            width: 10px;
        }

        .admin-scroll::-webkit-scrollbar-thumb {
            border-radius: 999px;
            background: rgba(100, 116, 139, 0.28);
        }

        body.sidebar-open {
            overflow: hidden;
        }
    </style>

    @RenderSection("Head", required: false)
</head>
<body class="min-h-screen bg-brand-shell text-brand-ink">
    <div class="min-h-screen">
        <aside id="adminSidebar" class="admin-scroll fixed inset-y-0 left-0 z-50 flex w-[86vw] max-w-72 -translate-x-full flex-col overflow-y-auto border-r border-brand-line bg-brand-ink text-white shadow-nav transition-transform duration-300 lg:w-72 lg:translate-x-0">
            <div class="border-b border-white/10 px-6 py-6">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="font-mono text-xs uppercase tracking-[0.24em] text-sky-200">EMS Solutions</p>
                        <h1 class="mt-3 text-2xl font-bold tracking-tight">Admin Workspace</h1>
                        <p class="mt-2 text-sm text-slate-300">Electrical retail, fulfillment, and stock control.</p>
                    </div>
                    <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-white/15 text-slate-200 lg:hidden" onclick="closeAdminSidebar()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <div class="mt-6 flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                    <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-sky-400/20 font-semibold text-sky-100">EM</div>
                    <div class="min-w-0">
                        <p class="truncate text-sm font-semibold text-white">EMS Manager</p>
                        <p class="truncate font-mono text-[11px] uppercase tracking-[0.16em] text-slate-300">Industrial Division</p>
                    </div>
                </div>
            </div>

            <nav class="flex-1 space-y-2 px-4 py-5">
                <a href="@Url.Action("Index", "Admin")" data-sidebar-link class="flex items-center gap-3 rounded-2xl px-4 py-3 transition @(isDashboard ? "bg-white text-brand-ink shadow-admin" : "text-slate-300 hover:bg-white/8 hover:text-white")">
                    <span class="material-symbols-outlined">dashboard</span>
                    <span class="flex-1">
                        <span class="block text-sm font-semibold">Analytics</span>
                        <span class="block text-xs @(isDashboard ? "text-brand-muted" : "text-slate-400")">Revenue, stock, and activity</span>
                    </span>
                </a>
                <a href="@Url.Action("Index", "Item")" data-sidebar-link class="flex items-center gap-3 rounded-2xl px-4 py-3 transition @(isProducts ? "bg-white text-brand-ink shadow-admin" : "text-slate-300 hover:bg-white/8 hover:text-white")">
                    <span class="material-symbols-outlined">inventory_2</span>
                    <span class="flex-1">
                        <span class="block text-sm font-semibold">Products</span>
                        <span class="block text-xs @(isProducts ? "text-brand-muted" : "text-slate-400")">Catalog and stock operations</span>
                    </span>
                </a>
                <a href="@Url.Action("GetAllCustomer", "Customer")" data-sidebar-link class="flex items-center gap-3 rounded-2xl px-4 py-3 transition @(isCustomers ? "bg-white text-brand-ink shadow-admin" : "text-slate-300 hover:bg-white/8 hover:text-white")">
                    <span class="material-symbols-outlined">groups</span>
                    <span class="flex-1">
                        <span class="block text-sm font-semibold">Customers</span>
                        <span class="block text-xs @(isCustomers ? "text-brand-muted" : "text-slate-400")">Profiles and account history</span>
                    </span>
                </a>
                <a href="@Url.Action("Index", "Order")" data-sidebar-link class="flex items-center gap-3 rounded-2xl px-4 py-3 transition @(isOrders ? "bg-white text-brand-ink shadow-admin" : "text-slate-300 hover:bg-white/8 hover:text-white")">
                    <span class="material-symbols-outlined">conveyor_belt</span>
                    <span class="flex-1">
                        <span class="block text-sm font-semibold">Orders</span>
                        <span class="block text-xs @(isOrders ? "text-brand-muted" : "text-slate-400")">Processing and fulfillment</span>
                    </span>
                </a>
            </nav>

            <div class="border-t border-white/10 px-6 py-6">
                <div class="space-y-3">
                    <a href="@Url.Action("Store", "Home")" data-sidebar-link class="flex items-center gap-3 text-sm text-slate-300 transition hover:text-white">
                        <span class="material-symbols-outlined">storefront</span>
                        View storefront
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="User" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="flex w-full items-center gap-3 border-0 bg-transparent p-0 text-sm text-rose-200 transition hover:text-white">
                                <span class="material-symbols-outlined">logout</span>
                                Sign out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="User" asp-action="Login" class="flex items-center gap-3 text-sm text-sky-200 transition hover:text-white">
                            <span class="material-symbols-outlined">login</span>
                            Sign in
                        </a>
                    }
                </div>
            </div>
        </aside>

        <div id="adminSidebarBackdrop" class="fixed inset-0 z-40 hidden bg-slate-950/45 lg:hidden" onclick="closeAdminSidebar()"></div>

        <div class="lg:pl-72">
            <header class="sticky top-0 z-30 border-b border-brand-line/80 bg-white/92 backdrop-blur">
                <div class="mx-auto flex w-full max-w-shell items-center justify-between gap-4 px-4 py-4 sm:px-6 xl:px-8">
                    <div class="flex min-w-0 items-center gap-3">
                        <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-brand-line bg-white text-brand-ink shadow-sm lg:hidden" onclick="openAdminSidebar()">
                            <i class="bi bi-list text-lg"></i>
                        </button>
                        <div class="min-w-0">
                            <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-brand-muted">Operations center</p>
                            <h2 class="truncate text-xl font-bold text-brand-ink sm:text-2xl">@adminHeading</h2>
                            <p class="hidden text-sm text-brand-muted md:block">@adminSubtitle</p>
                        </div>
                    </div>

                    <div class="flex shrink-0 items-center gap-3">
                        @if (IsSectionDefined("AdminActions"))
                        {
                            @RenderSection("AdminActions", required: false)
                        }
                        else
                        {
                            <a href="@Url.Action("Create", "Item")" class="inline-flex items-center gap-2 rounded-2xl bg-brand-primary px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-sky-900">
                                <span class="material-symbols-outlined text-base">add</span>
                                Add Product
                            </a>
                        }
                    </div>
                </div>
            </header>

            <main class="px-4 py-6 sm:px-6 xl:px-8 xl:py-8">
                <div class="admin-scroll mx-auto w-full max-w-shell">
                    @RenderBody()
                </div>
            </main>

            <footer class="border-t border-brand-line bg-white/88">
                <div class="mx-auto flex w-full max-w-shell flex-col gap-4 px-4 py-6 text-sm text-brand-muted sm:px-6 lg:flex-row lg:items-center lg:justify-between xl:px-8">
                    <div>
                        <p class="font-semibold text-brand-slate">EMS Solutions</p>
                        <p class="mt-1">&copy; @year Electrical Management System. Operational dashboard for stock, orders, and customer support.</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-4">
                        <a href="@Url.Action("Privacy", "Home")" class="transition hover:text-brand-primary">Privacy</a>
                        <a href="@Url.Action("Index", "Order")" class="transition hover:text-brand-primary">Orders</a>
                        <a href="@Url.Action("GetAllCustomer", "Customer")" class="transition hover:text-brand-primary">Customers</a>
                        <a href="@Url.Action("Index", "Item")" class="transition hover:text-brand-primary">Inventory</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        const adminSidebar = document.getElementById("adminSidebar");
        const adminSidebarBackdrop = document.getElementById("adminSidebarBackdrop");
        const adminSidebarLinks = document.querySelectorAll("[data-sidebar-link]");
        const adminDesktopMediaQuery = window.matchMedia("(min-width: 1024px)");

        function syncAdminSidebar() {
            if (adminDesktopMediaQuery.matches) {
                adminSidebar.classList.remove("-translate-x-full");
                adminSidebarBackdrop.classList.add("hidden");
                document.body.classList.remove("sidebar-open");
                return;
            }

            if (!document.body.classList.contains("sidebar-open")) {
                adminSidebar.classList.add("-translate-x-full");
            }
        }

        function openAdminSidebar() {
            adminSidebar.classList.remove("-translate-x-full");
            adminSidebarBackdrop.classList.remove("hidden");
            document.body.classList.add("sidebar-open");
        }

        function closeAdminSidebar() {
            adminSidebar.classList.add("-translate-x-full");
            adminSidebarBackdrop.classList.add("hidden");
            document.body.classList.remove("sidebar-open");
        }

        adminSidebarLinks.forEach(link => {
            link.addEventListener("click", () => {
                if (!adminDesktopMediaQuery.matches) {
                    closeAdminSidebar();
                }
            });
        });

        document.addEventListener("keydown", event => {
            if (event.key === "Escape" && document.body.classList.contains("sidebar-open")) {
                closeAdminSidebar();
            }
        });

        adminDesktopMediaQuery.addEventListener("change", syncAdminSidebar);
        syncAdminSidebar();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
