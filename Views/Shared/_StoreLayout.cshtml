@using System.Security.Claims
@{
    var query = (string?)ViewBag.Query ?? string.Empty;
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var isCustomer = User?.IsInRole("Customer") ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="T-Socket Gadgets — Shop premium gadgets, accessories & electronics. Fast delivery, secure payment." />
    <title>@(ViewBag.Title ?? "T-Socket Gadgets")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/ts-theme.css" asp-append-version="true" />

    <style>
        /* ── Global Reset & Tokens ──────────────────────────────── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --clr-bg:          #f4f5f7;
            --clr-surface:     #ffffff;
            --clr-surface-2:   #fafafa;
            --clr-border:      rgba(15,23,42,0.09);
            --clr-border-soft: rgba(15,23,42,0.05);

            --clr-primary:     #6c2bd9;
            --clr-primary-dk:  #5521b5;
            --clr-primary-lt:  #7c3aed;
            --clr-primary-a10: rgba(108,43,217,0.10);
            --clr-primary-a20: rgba(108,43,217,0.20);
            --clr-primary-a30: rgba(108,43,217,0.30);

            --clr-amber:       #f59e0b;
            --clr-green:       #16a34a;
            --clr-red:         #dc2626;

            --clr-text:        #0f172a;
            --clr-text-2:      #1e293b;
            --clr-muted:       #64748b;
            --clr-light:       #94a3b8;

            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 18px;
            --radius-xl: 24px;
            --radius-pill: 999px;

            --shadow-nav:  0 2px 40px rgba(15,23,42,0.10);
            --shadow-sm:   0 1px 4px rgba(15,23,42,0.06);
            --shadow-md:   0 4px 20px rgba(15,23,42,0.09);
            --shadow-lg:   0 12px 40px rgba(15,23,42,0.12);

            --nav-h: 70px;
            --transition: 0.2s cubic-bezier(0.4,0,0.2,1);
        }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: var(--clr-bg);
            color: var(--clr-text);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Navbar ─────────────────────────────────────────────── */
        .ts-nav {
            position: sticky;
            top: 0;
            z-index: 1000;
            height: var(--nav-h);
            background: rgba(255,255,255,0.85);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border-bottom: 1px solid var(--clr-border);
            box-shadow: var(--shadow-nav);
            transition: background var(--transition), box-shadow var(--transition);
        }

        .ts-nav.scrolled {
            background: rgba(255,255,255,0.96);
            box-shadow: 0 4px 30px rgba(15,23,42,0.13);
        }

        .ts-nav-inner {
            height: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        /* Logo */
        .ts-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none !important;
            flex-shrink: 0;
        }

        .ts-logo-icon {
            width: 40px;
            height: 40px;
            border-radius: 13px;
            background: linear-gradient(135deg, var(--clr-primary) 0%, var(--clr-primary-lt) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 17px;
            font-weight: 900;
            letter-spacing: -1px;
            box-shadow: 0 6px 20px var(--clr-primary-a30);
            transition: transform var(--transition), box-shadow var(--transition);
        }

        .ts-logo:hover .ts-logo-icon {
            transform: rotate(-5deg) scale(1.07);
            box-shadow: 0 10px 28px var(--clr-primary-a30);
        }

        .ts-logo-text { display: flex; flex-direction: column; line-height: 1; }
        .ts-logo-name { font-size: 15px; font-weight: 800; color: var(--clr-text); letter-spacing: -0.03em; }
        .ts-logo-sub  { font-size: 10.5px; color: var(--clr-muted); font-weight: 500; margin-top: 1px; }

        /* Search */
        .ts-search {
            flex: 1;
            max-width: 520px;
            display: flex;
            background: var(--clr-surface);
            border: 1.5px solid var(--clr-border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            transition: border-color var(--transition), box-shadow var(--transition);
        }

        .ts-search:focus-within {
            border-color: var(--clr-primary-a30);
            box-shadow: 0 0 0 4px var(--clr-primary-a10);
        }

        .ts-search input {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            padding: 0.72rem 1rem;
            font-size: 14px;
            font-family: inherit;
            color: var(--clr-text);
        }

        .ts-search input::placeholder { color: var(--clr-light); }

        .ts-search button {
            border: none;
            background: linear-gradient(135deg, var(--clr-primary), var(--clr-primary-lt));
            color: #fff;
            padding: 0 1.1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13.5px;
            font-weight: 600;
            font-family: inherit;
            white-space: nowrap;
            transition: filter var(--transition);
        }

        .ts-search button:hover { filter: brightness(1.1); }

        /* Nav actions */
        .ts-nav-actions {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-left: auto;
            flex-shrink: 0;
        }

        .ts-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.48rem 0.95rem;
            border: 1.5px solid var(--clr-border);
            border-radius: var(--radius-pill);
            background: var(--clr-surface);
            color: var(--clr-text-2);
            font-size: 13.5px;
            font-weight: 600;
            text-decoration: none !important;
            white-space: nowrap;
            cursor: pointer;
            transition: all var(--transition);
        }

        .ts-pill:hover, .ts-pill:focus {
            border-color: var(--clr-primary-a30);
            color: var(--clr-primary);
            background: var(--clr-primary-a10);
            box-shadow: var(--shadow-sm);
        }

        .ts-pill.active {
            background: var(--clr-primary);
            border-color: var(--clr-primary);
            color: #fff !important;
        }

        /* Cart icon button */
        .ts-cart-btn {
            position: relative;
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            border: 1.5px solid var(--clr-border);
            background: var(--clr-surface);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--clr-text-2);
            font-size: 18px;
            text-decoration: none !important;
            cursor: pointer;
            transition: all var(--transition);
        }

        .ts-cart-btn:hover {
            border-color: var(--clr-primary-a30);
            color: var(--clr-primary);
            background: var(--clr-primary-a10);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

        .ts-cart-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: var(--clr-red);
            color: #fff;
            font-size: 9.5px;
            font-weight: 800;
            min-width: 18px;
            height: 18px;
            padding: 0 4px;
            border-radius: var(--radius-pill);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--clr-surface);
        }

        /* Dropdown */
        .ts-nav .dropdown-menu {
            border-radius: var(--radius-lg);
            border: 1px solid var(--clr-border);
            box-shadow: var(--shadow-lg);
            padding: 6px;
            min-width: 180px;
        }

        .ts-nav .dropdown-item {
            border-radius: var(--radius-sm);
            font-size: 13.5px;
            font-weight: 500;
            padding: 0.52rem 0.85rem;
            color: var(--clr-text-2);
            transition: all var(--transition);
        }

        .ts-nav .dropdown-item:hover {
            background: var(--clr-primary-a10);
            color: var(--clr-primary);
        }

        /* Mobile search bar */
        .ts-nav-mobile-search {
            display: none;
            padding: 0 1rem 0.85rem;
        }

        /* ── Main content ────────────────────────────────────────── */
        .ts-main {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem 1.5rem 4rem;
        }

        /* ── Footer ─────────────────────────────────────────────── */
        .ts-footer {
            background: var(--clr-surface);
            border-top: 1px solid var(--clr-border);
            padding: 2rem 1.5rem;
            text-align: center;
            color: var(--clr-muted);
            font-size: 13px;
        }

        .ts-footer a { color: var(--clr-primary); text-decoration: none; font-weight: 600; }

        /* ── Scroll-to-top ───────────────────────────────────────── */
        #ts-scroll-top {
            position: fixed;
            bottom: 28px;
            right: 28px;
            width: 46px;
            height: 46px;
            border-radius: var(--radius-md);
            background: var(--clr-primary);
            color: #fff;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            box-shadow: 0 8px 24px var(--clr-primary-a30);
            opacity: 0;
            pointer-events: none;
            transform: translateY(12px);
            transition: opacity 0.3s, transform 0.3s;
            z-index: 999;
        }

        #ts-scroll-top.visible {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }

        #ts-scroll-top:hover {
            background: var(--clr-primary-dk);
            transform: translateY(-2px);
            box-shadow: 0 12px 32px var(--clr-primary-a30);
        }

        /* ── Responsive ─────────────────────────────────────────── */
        @@media (max-width: 991px) {
            .ts-search { max-width: 100%; display: none; }
            .ts-logo-sub { display: none; }
            .ts-nav-mobile-search { display: block; }
        }
        @@media (max-width: 575px) {
            .ts-logo-text { display: none; }
            .ts-main { padding: 1.25rem 1rem 3rem; }
        }
    </style>
</head>
<body>

    <!-- ── Navbar ────────────────────────────────────────────── -->
    <nav class="ts-nav" id="ts-navbar" role="navigation" aria-label="Main navigation">
        <div class="ts-nav-inner">

            <!-- Logo -->
            <a class="ts-logo" asp-action="Store" asp-controller="Home" aria-label="T-Socket Gadgets — Home">
                <div class="ts-logo-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                <div class="ts-logo-text d-none d-sm-flex">
                    <span class="ts-logo-name">T-Socket</span>
                    <span class="ts-logo-sub">Gadgets &amp; Tech</span>
                </div>
            </a>

            <!-- Search (desktop) -->
            <form class="ts-search d-none d-lg-flex" asp-action="Store" asp-controller="Home" method="get" role="search" aria-label="Product search">
                <input type="search" name="q" value="@query" placeholder="Search products, brands…" aria-label="Search products" autocomplete="off" />
                <button type="submit" aria-label="Submit search">
                    <i class="bi bi-search"></i>
                    <span>Search</span>
                </button>
            </form>

            <!-- Nav actions -->
            <div class="ts-nav-actions">

                @if (isAdmin)
                {
                    <a class="ts-pill d-none d-md-inline-flex" asp-controller="Item" asp-action="Index" title="Admin Dashboard">
                        <i class="bi bi-speedometer2"></i> Admin
                    </a>
                }

                @if (!isAuthenticated)
                {
                    <a class="ts-pill d-none d-sm-inline-flex" asp-controller="User" asp-action="Login" asp-route-returnUrl="@returnUrl">
                        <i class="bi bi-person-circle"></i> Login
                    </a>
                }
                else
                {
                    <div class="dropdown">
                        <button class="ts-pill dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="userMenuBtn">
                            <i class="bi bi-person-circle"></i>
                            <span class="d-none d-sm-inline">@(User?.Identity?.Name?.Split(' ')[0] ?? "Account")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuBtn">
                            @if (isCustomer)
                            {
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="Index"><i class="bi bi-grid me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="CustomerProfile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                <li><hr class="dropdown-divider mx-2" /></li>
                            }
                            <li><a class="dropdown-item text-danger" asp-controller="User" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                        </ul>
                    </div>
                }

                <!-- Cart -->
                <div class="position-relative">
                    @if (isCustomer)
                    {
                        <a class="ts-cart-btn" asp-controller="Cart" asp-action="Index" title="View Cart" aria-label="View cart">
                            <i class="bi bi-bag"></i>
                        </a>
                        <span id="cart-count-badge" class="ts-cart-badge d-none" aria-live="polite" aria-label="Cart items count">0</span>
                    }
                    else
                    {
                        <a class="ts-cart-btn" asp-controller="User" asp-action="Login" asp-route-returnUrl="@returnUrl" title="Login to access cart" aria-label="Login to access cart">
                            <i class="bi bi-bag"></i>
                        </a>
                    }
                </div>

            </div>
        </div>

        <!-- Mobile search -->
        <div class="ts-nav-mobile-search d-lg-none">
            <form class="ts-search d-flex" asp-action="Store" asp-controller="Home" method="get" role="search" aria-label="Product search mobile">
                <input type="search" name="q" value="@query" placeholder="Search products…" aria-label="Search products" autocomplete="off" />
                <button type="submit" aria-label="Submit search"><i class="bi bi-search"></i></button>
            </form>
        </div>
    </nav>

    <!-- ── Main ──────────────────────────────────────────────── -->
    <main class="ts-main" id="main-content">
        @RenderBody()
    </main>

    <!-- ── Footer ────────────────────────────────────────────── -->
    <footer class="ts-footer" role="contentinfo">
        <p>&copy; @DateTime.Now.Year <a asp-controller="Home" asp-action="Store">T-Socket Gadgets</a> &mdash; Shop smart &bull; Pay secure</p>
    </footer>

    <!-- Scroll to top -->
    <button id="ts-scroll-top" aria-label="Scroll back to top" title="Back to top">
        <i class="bi bi-arrow-up"></i>
    </button>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            // ── Navbar scroll effect
            const nav = document.getElementById('ts-navbar');
            if (nav) {
                const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 20);
                window.addEventListener('scroll', onScroll, { passive: true });
                onScroll();
            }

            // ── Scroll-to-top button
            const scrollBtn = document.getElementById('ts-scroll-top');
            if (scrollBtn) {
                window.addEventListener('scroll', () => {
                    scrollBtn.classList.toggle('visible', window.scrollY > 400);
                }, { passive: true });
                scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
            }

            // ── Cart count badge
            const badge = document.getElementById('cart-count-badge');
            if (!badge) return;
            const updateCartCount = async () => {
                try {
                    const res = await fetch('@Url.Action("Count", "Cart")', {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!res.ok) return;
                    const data = await res.json();
                    const count = Number(data?.count ?? 0);
                    badge.textContent = count > 99 ? '99+' : String(count);
                    badge.classList.toggle('d-none', count <= 0);
                } catch { /* silent */ }
            };
            updateCartCount();
            window.setInterval(updateCartCount, 8000);
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
